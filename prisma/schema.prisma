generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth ---------------------------------------------------------------

enum Role {
  ADMIN // can edit data and manage team member roles
  EDITOR // can edit data
  VIEWER // read-only
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  ownedContacts  Contact[] @relation("ContactOwner")
  warmPathFor    Contact[] @relation("ContactWarmPath")
  travelPlans    Travel[]
  editLogEntries EditLogEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain ---------------------------------------------------------------

enum ContactType {
  LP_INSTITUTIONAL
  FAMILY_OFFICE
  PLACEMENT_AGENT
  BROKER_ADVISOR
  SPONSOR_COGP
  CONSULTANT
  OTHER
}

enum ContactTier {
  TIER_1
  TIER_2
  TIER_3
}

// The fundraising/syndication funnel — used by Contact (LP-level),
// DealFeedback (company/LP-level, the same funnel just anchored at the
// company), and Consultant/CapitalSource (Emerging Managers outreach, once
// it gets real correspondence and stage tracking of its own). Due diligence
// specifically means an NDA has been executed and/or the LP has been given
// access to the data room, not just "looking at it." The two passed stages
// distinguish someone worth re-approaching on a future deal from a genuine no.
enum FundraisingStage {
  NOT_STARTED
  OUTREACH_SENT
  INITIAL_INTEREST
  MEETING_OCCURRED
  ACTIVE_PROSPECT // deliberate, targeted courting for a specific raise — more intentional than a general follow-up
  DUE_DILIGENCE
  COMMITTED
  PASSED_OPEN // passed on this deal, open to future ones
  PASSED_NOT_INTERESTED // a genuine no
  DO_NOT_CONTACT // a firm stop — compliance/preference, not just a soft pass
}

model Contact {
  id                 String           @id @default(cuid())
  name               String
  org                String?
  type               ContactType      @default(OTHER)
  tier               ContactTier      @default(TIER_2)
  status             FundraisingStage @default(NOT_STARTED)
  ownerId            String?
  owner              User?         @relation("ContactOwner", fields: [ownerId], references: [id])
  warmPathId         String?
  warmPath           User?         @relation("ContactWarmPath", fields: [warmPathId], references: [id])
  email              String?
  phone              String?
  city               String?
  lastContact        DateTime?     @db.Date
  cadenceOverrideDays Int?
  priorityQuarter    String? // e.g. "2026-Q3"
  tags               String[]      @default([])
  notes              String?       @default("")
  // { templateId, templateName, startDate, completed, steps: [{type,title,dueDate,done,doneDate}] } | null
  activeSequence     Json?
  // Null until this contact has been included in an "export new contacts for
  // Agora" batch — lets that export always mean "everyone since last time",
  // whether the contact was added manually or confirmed from the Inbox.
  agoraExportedAt    DateTime?
  // Timestamp of the last "export contact changes for Agora" batch this
  // contact was included in — separate from agoraExportedAt, which only ever
  // fires once (the "brand new contact" export). A contact is "changed since
  // we last told Agora" whenever updatedAt is newer than this (or this is
  // still null and the contact already has agoraExportedAt set).
  agoraChangesSyncedAt DateTime?
  // Public-web research (bio snippet + recent news), refreshed on demand from
  // the contact card. Null/empty until a team member requests it — this is
  // never fetched automatically, since coverage is inherently uneven.
  researchBio        String?
  researchBioSource  String?
  // [{ title, url, date, summary }]
  researchNews       Json?
  researchUpdatedAt  DateTime?
  // --- Agora reference data (read-only in the app; refreshed on the next
  // "Import from Agora" sync, never hand-edited) ---
  agoraType          String? // Agora's own "Type" categorization, e.g. "Family Office", "Investor"
  primaryLocation    String? // Agora's coarse "Primary Location", e.g. "SF Bay Area"
  staffNames         String[] @default([]) // raw "Staff Members" names, however many Agora lists
  commitmentLow      Float?
  commitmentHigh     Float?
  emailTier          Int? // Agora's "Tier for Email Tracking" — unrelated to our own ContactTier
  agoraRaw           Json? // the full parsed row from the Agora export, every column, for full fidelity
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Which side(s) of the business this record actually belongs to —
  // inferred from import provenance (AREF I Tracker vs. Capital Partner
  // Outreach/LP List) rather than guessed from tier, which is a priority
  // ranking, not a category. A contact can be both: someone whose employer
  // is a deal-level LP but who is also personally an individual fund
  // investor. Empty means "no signal either way" — an existing record that
  // predates this field, still shown in Target Investors exactly as
  // before; only a DEAL-only classification (no FUND alongside it)
  // excludes it. Company stays single-valued (see Company.recordContext) —
  // this same ambiguity doesn't apply there: the person invests personally,
  // not their employer.
  recordContexts RecordContext[] @default([])

  // A 1-5 team judgment call on how likely this person is to actually close,
  // shown as stars in the Funnel view. Most useful for Active prospect, where
  // "same stage" can still mean very different odds, but not restricted to
  // it — nothing enforces a stage here, since a rough read can be worth
  // recording earlier too. Null means nobody's rated it yet.
  closeProbability Int?

  tasks Task[]
  correspondence Correspondence[]
  stageChanges   ContactStatusChange[]
  dealFeedback   DealFeedback[]

  @@index([status])
  @@index([type])
  @@index([tier])
  @@index([ownerId])
  @@index([agoraType])
  @@index([primaryLocation])
  @@index([companyId])
}

enum RecordContext {
  FUND
  DEAL
}

// A real record for a capital partner/company, promoted out of the free-text
// Contact.org string so deal feedback (and investment-criteria data) can live
// at the company level, not just on whichever one contact happens to hold it.
// Existing contacts keep their `org` string untouched; `companyId` is an
// optional link on top, backfilled from distinct org names.
model Company {
  id   String @id @default(cuid())
  name String @unique
  type ContactType  @default(OTHER)
  tier ContactTier?
  priorityQuarter String? // e.g. "2026-Q3" — same Priorities matrix as Contact
  city String?
  tags String[] @default([])
  notes String? @default("")

  // Which upstream export(s) this record's data has come from — e.g. "Agora
  // Contact Export", "Agora Org Export", "AREF I Tracker", "Deal/LP
  // Spreadsheet". A company built from more than one source keeps every tag
  // it has ever earned; this is the audit trail the team needs to trust a
  // collapsed, cross-source view instead of one silo per source.
  sources String[] @default([])
  // Null until this company has been included in an "export new companies for
  // Agora" batch — same convention as Contact.agoraExportedAt.
  agoraExportedAt DateTime?
  website String?
  linkedinUrl String?
  aum String? // free text ("~$10B+") — source data isn't consistently numeric
  founded String? // free text — a handful of sources give a range or "N/A" instead of a clean year

  // Durable "what do they generally invest in" profile — separate from any
  // one deal's feedback, so a new raise can quickly filter to matching
  // capital partners (e.g. "who's interested in self storage") rather than
  // digging back through past deal notes.
  targetAssetClasses   String[] @default([]) // e.g. Industrial, Multifamily, Retail, Self-Storage, NNN
  investmentStructures String[] @default([]) // e.g. Co-GP, LP Equity, Structured Equity, Debt Capital, Other Strategic
  investmentStrategies String[] @default([]) // e.g. Core, Core+, Value-Add / Opp
  investmentSizeMin   Float?
  investmentSizeMax   Float?

  // Same fund-vs-deal distinction as Contact.recordContext — see that field's
  // comment. Null means no signal either way.
  recordContext RecordContext?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  feedback DealFeedback[]
  outreach DealOutreach[]

  @@index([name])
  @@index([recordContext])
}

enum DealStatus {
  ACTIVE
  UNDER_CONTRACT
  DEAD
  DORMANT
}

model Deal {
  id         String     @id @default(cuid())
  name       String
  status     DealStatus @default(ACTIVE)
  assetClass String? // optional, e.g. "Self-Storage" — lets a new deal be matched against Company.targetAssetClasses
  notes      String?    @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  feedback DealFeedback[]
  outreach DealOutreach[]

  @@index([status])
}

enum FeedbackSource {
  MANUAL // typed in directly, e.g. from a call
  CORRESPONDENCE // pulled from an email/Teams message
}

// One piece of feedback on one deal, from one company (and optionally a
// specific contact there). Company is the anchor for "feedback by company"
// rollups; contact is who actually said it, when known.
model DealFeedback {
  id        String         @id @default(cuid())
  dealId    String
  deal      Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status    FundraisingStage @default(NOT_STARTED)
  notes     String
  source    FeedbackSource @default(MANUAL)
  // Set once a message is auto-classified as deal feedback (not built yet —
  // this just leaves room for that without a future migration).
  correspondenceId String?         @unique
  correspondence    Correspondence? @relation(fields: [correspondenceId], references: [id], onDelete: SetNull)
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dealId])
  @@index([companyId])
  @@index([contactId])
}

// Records that a deal was actually sent/tracked to a company — separate from
// DealFeedback, which requires an actual note. Answers "who received this
// deal" even when they never responded with anything worth logging as
// feedback. One row per (deal, company): re-sending the same deal to the
// same company just refreshes sentAt rather than creating a duplicate.
model DealOutreach {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())

  @@unique([dealId, companyId])
  @@index([companyId])
}

// Remembers a cluster of companies a human looked at and confirmed are NOT
// duplicates, so the same suggestion doesn't keep resurfacing on every visit
// to the Companies review queue. groupKey is the cluster's company ids,
// sorted and joined — a different cluster (even if it overlaps) gets its own
// key and still surfaces normally.
model CompanyMergeDismissal {
  id        String   @id @default(cuid())
  groupKey  String   @unique
  createdAt DateTime @default(now())
}

// Remembers an org string (from a Contact with no matching Company record)
// that a human looked at on the New Companies queue and decided doesn't need
// its own Company record (e.g. "Private Investor," a placeholder, a one-off).
// orgKey is the normalized org text so re-typed variants still match.
model NewCompanyDismissal {
  id        String   @id @default(cuid())
  orgKey    String   @unique
  createdAt DateTime @default(now())
}

// Same idea as CompanyMergeDismissal, for the Contacts duplicate-review queue.
model ContactMergeDismissal {
  id        String   @id @default(cuid())
  groupKey  String   @unique
  createdAt DateTime @default(now())
}

// --- Emerging Managers -----------------------------------------------------
// A deliberately separate track from Contacts/Companies: a capital source or
// consultant here may well be the same real institution as an existing
// contact/company, but this outreach is tracked on its own — different
// cadence, different pitch, different program rules — rather than folded
// into the general relationship data.

model Consultant {
  id                       String        @id @default(cuid())
  name                     String        @unique
  capitalSourcesCoveredNote String?      @default("") // freeform, e.g. "LAFPP, LACERS" — the CapitalSource.consultant relation is the structured version where confidently parsed
  intakeProcess            String?       @default("")
  knownContacts            String?       @default("")
  nextStep                 String?       @default("")
  outreachStatus           FundraisingStage @default(NOT_STARTED)
  verificationNotes        String?       @default("")
  notes                    String?       @default("")
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  capitalSources CapitalSource[]
  correspondence Correspondence[]

  @@index([outreachStatus])
}

model CapitalSource {
  id               String        @id @default(cuid())
  name             String        @unique // "Capital Source (Detailed)" in the tracker
  shortName        String?
  tier             Int? // Arselle's own priority ranking (1 = highest), not in the source tracker — set manually
  outreachStatus   FundraisingStage @default(NOT_STARTED) // Arselle's own outreach stage — the tracker's "Status" column
  actionability    String?       @default("") // the tracker's own "how ready is this to act on" label, e.g. "Immediate - Website"
  nextStep         String?       @default("")
  timing           String? // e.g. "4Q2026" — when the tracker expects the next real step
  consultantId     String?
  consultant       Consultant?   @relation(fields: [consultantId], references: [id], onDelete: SetNull)
  programManager   String?
  consultantSource String?       @default("") // where the Consultant link/name came from
  knownCommitmentsCompetitors String? @default("")
  knownCommitmentsOperators   String? @default("")
  overview         String?       @default("")
  openDoorPolicy   String?       @default("")
  minimumFundSize  String? // kept as text — the tracker's values are often narrative, not a clean number
  minimumFundSizeSource  String? @default("")
  typicalCheckSize String?
  typicalCheckSizeSource String? @default("")
  keyContact       String?       @default("")
  emailsWebsites   String?       @default("")
  actionPlanSource String?       @default("") // sourcing for the overall outreach plan itself, distinct from any single field's source
  timeline         String? // upcoming known dates/events tied to this source
  capitalStatus    String? // the source's OWN program status (e.g. "Active, Empire II live") — distinct from outreachStatus
  capitalStatusSource String?    @default("")
  redFlags         String?       @default("")
  arselleFit       String?       @default("")
  notes            String?       @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  correspondence Correspondence[]

  @@index([outreachStatus])
  @@index([consultantId])
}

enum StageChangeSource {
  MANUAL // a person changed the status directly
  AI_SUGGESTED // a person confirmed an AI-proposed stage change from correspondence
  AI_AUTO_APPLIED // Settings > Auto-apply AI stage suggestions was on, so no one confirmed it
}

// One row per status transition, so the funnel/pipeline view can show movement
// over time rather than just a current snapshot, and "stuck in stage N days"
// can be computed from an actual timestamp instead of guessed at.
model ContactStatusChange {
  id             String            @id @default(cuid())
  contactId      String
  contact        Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fromStatus     FundraisingStage?
  toStatus       FundraisingStage
  note           String
  source         StageChangeSource @default(MANUAL)
  changedByName  String?
  createdAt      DateTime          @default(now())

  @@index([contactId])
  @@index([toStatus])
}

enum CorrespondenceStatus {
  MATCHED // linked to an existing contact
  SUGGESTED // sender didn't match any contact; AI-extracted fields await review
  IGNORED // a human dismissed the suggestion
}

// A single inbound message fed from the Fundraising Teams channel (or any
// future source). Ingested raw, then AI-extracted fields are used to either
// match an existing contact or propose creating a new one — nothing about a
// contact's own record changes just from ingestion.
model Correspondence {
  id            String               @id @default(cuid())
  source        String               @default("teams_channel")
  externalId    String?              @unique // dedupe key from the source system (e.g. Teams message id)
  subject       String?
  bodyText      String
  receivedAt    DateTime
  contactId     String?
  contact       Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // A message can instead be about an Emerging Managers target — a capital
  // source or a consultant — once the Teams ingestion is taught to match
  // those too. Not wired up to the matching pipeline yet; the columns exist
  // now so that doesn't need its own migration later.
  capitalSourceId String?
  capitalSource   CapitalSource?       @relation(fields: [capitalSourceId], references: [id], onDelete: SetNull)
  consultantId    String?
  consultant      Consultant?          @relation(fields: [consultantId], references: [id], onDelete: SetNull)
  extractedName String?
  extractedEmail String?
  extractedOrg  String?
  status        CorrespondenceStatus @default(SUGGESTED)
  createdAt     DateTime             @default(now())

  // AI's read of whether this message signals a pipeline-stage change for the
  // contact it's matched to. Only ever a suggestion — nothing here changes a
  // contact's actual status until a human confirms it via the stage-suggestion
  // endpoints, which is why it lives on the correspondence, not the contact.
  suggestedStatus     FundraisingStage?
  suggestionRationale String?
  suggestionState     SuggestionState @default(NONE)

  dealFeedback DealFeedback?

  @@index([contactId])
  @@index([capitalSourceId])
  @@index([consultantId])
  @@index([status])
  @@index([suggestionState])
}

enum SuggestionState {
  NONE // not classified, or classifier found no stage signal
  PENDING // awaiting human confirm/dismiss
  CONFIRMED
  DISMISSED
}

enum MailingListMode {
  STATIC
  DYNAMIC
}

model MailingList {
  id          String          @id @default(cuid())
  name        String
  description String?
  mode        MailingListMode @default(STATIC)

  // STATIC mode
  contactIds String[] @default([])

  // DYNAMIC mode: a saved filter, recomputed against Contact every time the
  // list is viewed rather than a fixed membership.
  filterType    ContactType?
  filterTier    ContactTier?
  filterOwnerId String?
  filterTag     String?
  filterStatus  FundraisingStage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ConferenceType {
  CONFERENCE
  NETWORKING
  ROADSHOW
  OTHER
}

model Conference {
  id          String         @id @default(cuid())
  name        String
  startDate   DateTime       @db.Date
  endDate     DateTime       @db.Date
  location    String?
  type        ConferenceType @default(OTHER)
  attendeeIds String[]       @default([])
  goals       String?        @default("")
  notes       String?        @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // --- Research-tracker fields (from the Emerging Managers conference
  // tracker), all optional so plain manually-added events are unaffected ---
  tier                Int? // 1 (highest priority) and up, per the tracker's own ranking
  organizer           String?
  registrationOpensAt DateTime? @db.Date
  registrationLink    String? // also the URL a "Refresh" checks for updates
  registrationStatus  String? // e.g. "Confirmed open", "Not yet open", "Invitation-only"
  dateConfidence      String? // e.g. "Confirmed on prea.org" vs "Estimate — assumes similar lead time"
  fitNote             String?
  // Set after a manual "Refresh" fetches registrationLink and asks the model
  // to re-read it — never applied automatically, just what the last check found.
  lastRefreshedAt     DateTime?

  // --- Year-over-year recurrence: instances of the same recurring conference
  // share a seriesId (the first occurrence's own id) so the team can see past
  // years at a glance and spin up next year's entry without re-researching it
  // from scratch. Plain one-off events leave this null. ---
  seriesId String?

  @@index([startDate])
  @@index([seriesId])
}

// One upcoming trip for one team member. City is free text, matched against
// Contact.city the same way (case-insensitive substring) rather than a
// controlled list — same "start simple, refine once we see real matching
// quality" call made for event-type inference.
model Travel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  notes     String?  @default("")
  createdAt DateTime @default(now())

  @@index([startDate])
  @@index([userId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

model Task {
  id        String       @id @default(cuid())
  title     String
  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Zero or more team-member User ids — a task can be assigned to nobody, one
  // person, or several jointly (replaces the old single ownerId plus a
  // free-text assigneeLabel hack for joint assignment). Plain array rather
  // than a join table, same convention as MailingList.contactIds elsewhere.
  assigneeIds String[]   @default([])
  dueDate   DateTime?    @db.Date
  status    TaskStatus   @default(OPEN)
  priority  TaskPriority @default(MEDIUM)
  notes     String?      @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
}

// Single-row table (id is always "singleton") holding admin-editable defaults.
model Settings {
  id                 String @id @default("singleton")
  defaultCadenceDays Int    @default(14)
  staleDays          Int    @default(45)
  stuckDays          Int    @default(30)
  // When on, a correspondence's AI-classified stage suggestion is applied to
  // the linked contact/consultant/capital source immediately instead of
  // waiting for a human to confirm it from the Inbox. Off by default — see
  // maybeCreateStageSuggestion in stage-signal.ts.
  autoApplyStageSuggestions Boolean @default(false)
  // Partial<Record<FundraisingStage, string>> — team-chosen display-label
  // overrides for the Funnel view's stage names (e.g. renaming "Fund II
  // Prospects" back to something else) without touching code. Null/missing
  // key means "use the built-in default" (FUNDRAISING_STAGE_LABELS).
  funnelStageLabels Json?
}

model SequenceTemplate {
  id        String   @id @default(cuid())
  name      String
  // [{ type: "Email"|"Call"|"LinkedIn"|"Other", title: string, waitDays: number }]
  steps     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per single-field change on a tracked entity (Contact/Company for
// now — see src/lib/edit-log.ts) — a lightweight audit trail for Data
// Quality's Edit Log tab, not a full field-level history of everything.
// entityLabel is a name snapshot at edit time so the log still reads
// sensibly after the entity itself is later renamed or deleted.
model EditLogEntry {
  id            String    @id @default(cuid())
  entityType    String
  entityId      String
  entityLabel   String
  field         String
  oldValue      String?
  newValue      String?
  changedById   String?
  changedBy     User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedByName String?
  createdAt     DateTime  @default(now())
  undone        Boolean   @default(false)
  undoneAt      DateTime?

  @@index([entityType, entityId])
  @@index([createdAt])
}
