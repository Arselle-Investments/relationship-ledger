# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/arselle_ledger"

# Microsoft Entra ID (Azure AD) app registration
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Restrict sign-in to Arselle accounts
ALLOWED_EMAIL_DOMAIN="arselleinvestments.com"

# Dev-only sign-in bypass (see src/app/api/dev-login). Leave unset/false outside
# local development — this must never be "true" in a real deployment.
ALLOW_DEV_LOGIN="true"

# Claude API (extraction/classification for the Teams-channel correspondence pipeline)
ANTHROPIC_API_KEY=""

# Shared secret the Power Automate flow sends in the x-webhook-secret header
# when POSTing a new Teams channel message to /api/integrations/teams-message
TEAMS_WEBHOOK_SECRET=""
